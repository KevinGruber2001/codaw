{
  "private": true,
  "name": "codaw-browser-app",
  "description": "CodaW browser product",
  "productName": "CodaW",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/KevinGruber2001/codaw#readme",
  "bugs": {
    "url": "https://github.com/KevinGruber2001/codaw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinGruber2001/codaw.git"
  },
  "dependencies": {
    "@theia/core": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/file-search": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/keymaps": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/workspace": "1.77.0",
    "codaw-product": "0.1.0"
  },
  "devDependencies": {
    "@theia/cli": "1.77.0"
  },
  "scripts": {
    "bundle": "npm run rebuild && theia build --mode development",
    "bundle:prod": "npm run rebuild && theia build",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "theia start",
    "watch": "npm run rebuild && theia build --watch --mode development"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "CodaW",
        "reloadOnReconnect": true,
        "preferences": {
          "files.autoSave": "afterDelay",
          "files.autoSaveDelay": 500,
          "workbench.colorTheme": "dark"
        }
      }
    },
    "backend": {
      "config": {
        "configurationFolder": ".codaw",
        "startupTimeout": -1
      }
    },
    "generator": {
      "config": {
        "preloadTemplate": "./resources/preload.html"
      }
    }
  }
}
