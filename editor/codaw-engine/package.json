{
  "private": true,
  "name": "codaw-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "The connection to the CodaW audio engine, and its log.",
  "license": "MIT",
  "keywords": [
    "theia-extension"
  ],
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/core": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/workspace": "1.77.0"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "@types/react": "^19.3.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "compile": "npm run clean && npm run build",
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc -w"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/engine-log-frontend-module",
      "backend": "lib/node/engine-backend-module"
    }
  ],
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./lib/*.json": "./lib/*.json",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./*": "./*"
  }
}
