{
  "private": true,
  "name": "codaw-language",
  "version": "0.1.0",
  "type": "module",
  "description": "CodaW language support",
  "license": "MIT",
  "keywords": [
    "theia-extension"
  ],
  "files": [
    "lib",
    "src"
  ],
  "dependencies": {
    "@theia/core": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/monaco-editor-core": "1.108.201",
    "codaw-engine": "0.1.0",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.9.3",
    "@types/node": "26.6.6"
  },
  "scripts": {
    "compile": "npm run clean && npm run build",
    "clean": "rimraf lib",
    "build": "tsc",
    "watch": "tsc -w"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/language-frontend-module",
      "backend": "lib/node/language-backend-module"
    }
  ],
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./lib/*.json": "./lib/*.json",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./*": "./*"
  }
}
